# PayPal sandbox only. Never use live credentials.
PAYPAL_ENV=sandbox
# Live is refused unless ALLOW_LIVE=1. Leave unset.
# ALLOW_LIVE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server side only)
ANTHROPIC_API_KEY=
# Optional model id, default claude-sonnet-5-5
AI_MODEL=

# Optional, only for the AG Grid view (trial key, never commit)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
